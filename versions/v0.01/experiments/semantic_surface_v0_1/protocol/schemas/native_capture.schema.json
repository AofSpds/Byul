{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AofSpds/Byul/semantic_surface_v0_1/protocol/native_capture.schema.json",
  "title": "Semantic Surface v0.1 byte-exact candidate native capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "capture_id",
    "run_id",
    "attempt_id",
    "run_manifest_ref",
    "stimulus_ref",
    "candidate_ref",
    "harness_ref",
    "runner_ref",
    "environment_ref",
    "dependency_lock_ref",
    "capture_tool_ref",
    "capture_started_at",
    "capture_ended_at",
    "process_status",
    "capture_completeness",
    "artifacts",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "protocol_id": { "const": "SEMANTIC_SURFACE_SUCCESSOR_PROTOCOL_0_1" },
    "capture_id": { "type": "string", "pattern": "^NC_[0-9a-f]{32}$" },
    "run_id": { "type": "string", "pattern": "^RN_[0-9a-f]{32}$" },
    "attempt_id": { "type": "string", "pattern": "^AT_[0-9a-f]{32}$" },
    "run_manifest_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "stimulus_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "candidate_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "harness_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "runner_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "environment_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "dependency_lock_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "capture_tool_ref": { "$ref": "#/$defs/immutableArtifactRef" },
    "capture_started_at": { "type": "string", "format": "date-time" },
    "capture_ended_at": { "type": "string", "format": "date-time" },
    "process_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "signal", "timed_out", "killed_by_controller"],
      "properties": {
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "timed_out": { "type": "boolean" },
        "killed_by_controller": { "type": "boolean" }
      }
    },
    "capture_completeness": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capturedArtifact" }
    },
    "authority_boundary": { "$ref": "#/$defs/authorityBoundary" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifacts": {
            "contains": {
              "type": "object",
              "properties": { "truncated": { "const": true } },
              "required": ["truncated"]
            }
          }
        },
        "required": ["artifacts"]
      },
      "then": {
        "properties": { "capture_completeness": { "const": "PARTIAL" } }
      }
    },
    {
      "if": {
        "properties": { "capture_completeness": { "const": "COMPLETE" } },
        "required": ["capture_completeness"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": { "truncated": { "const": false } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "immutableArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "locator",
        "sha256",
        "byte_length",
        "media_type",
        "immutability"
      ],
      "properties": {
        "ref_id": { "type": "string", "pattern": "^RF_[0-9a-f]{32}$" },
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "pattern": "^[^\\s/]+/[^\\s/]+$" },
        "immutability": {
          "enum": ["GIT_BLOB", "CONTENT_ADDRESS", "OCI_DIGEST", "ACL_SEALED_OBJECT"]
        }
      }
    },
    "capturedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "channel",
        "locator",
        "sha256",
        "byte_length",
        "media_type",
        "content_encoding",
        "charset",
        "byte_exact",
        "normalization_applied",
        "truncated",
        "truncation_evidence",
        "parse_status"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^NA_[0-9a-f]{32}$" },
        "channel": {
          "enum": ["STDOUT", "STDERR", "FILE", "DIRECTORY_MANIFEST", "EXIT_RECORD", "OTHER"]
        },
        "locator": { "$ref": "#/$defs/immutableArtifactRef" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "pattern": "^[^\\s/]+/[^\\s/]+$" },
        "content_encoding": {
          "enum": ["BINARY", "UTF-8", "US-ASCII", "UTF-16LE", "UTF-16BE", "OTHER"]
        },
        "charset": { "type": ["string", "null"] },
        "byte_exact": { "const": true },
        "normalization_applied": { "const": false },
        "truncated": { "type": "boolean" },
        "truncation_evidence": {
          "oneOf": [
            { "$ref": "#/$defs/truncationEvidence" },
            { "type": "null" }
          ]
        },
        "parse_status": { "enum": ["NOT_ATTEMPTED", "SUCCESS", "FAILED"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "truncated": { "const": true } },
            "required": ["truncated"]
          },
          "then": {
            "properties": {
              "truncation_evidence": { "$ref": "#/$defs/truncationEvidence" }
            }
          },
          "else": {
            "properties": { "truncation_evidence": { "type": "null" } }
          }
        }
      ]
    },
    "truncationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "captured_prefix_byte_length",
        "configured_limit_bytes",
        "original_byte_length",
        "original_sha256",
        "evidence_refs"
      ],
      "properties": {
        "reason": {
          "enum": [
            "BYTE_LIMIT",
            "RESOURCE_BUDGET",
            "TIMEOUT",
            "CONTROLLER_STOP",
            "IO_FAILURE",
            "UNKNOWN"
          ]
        },
        "captured_prefix_byte_length": { "type": "integer", "minimum": 0 },
        "configured_limit_bytes": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "original_byte_length": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "original_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/immutableArtifactRef" }
        }
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_claim",
        "selection_authority",
        "promotion_authority",
        "main_merge_authority",
        "production_authority"
      ],
      "properties": {
        "validation_claim": { "const": "NONE" },
        "selection_authority": { "const": "NONE" },
        "promotion_authority": { "const": "NONE" },
        "main_merge_authority": { "const": false },
        "production_authority": { "const": false }
      }
    }
  }
}
