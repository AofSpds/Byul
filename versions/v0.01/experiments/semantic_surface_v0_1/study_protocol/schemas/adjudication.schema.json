        { "$ref": "#/$defs/sameFinalUnmappable" },
        { "$ref": "#/$defs/sameFinalAmbiguous" },
        { "$ref": "#/$defs/sameFinalUnscorable" }
      ]
    },
    "sameFinalConforming": {
      "properties": {
        "graders": { "prefixItems": [
          { "properties": { "final_judgment": { "const": "CONFORMING" } } },
          { "properties": { "final_judgment": { "const": "CONFORMING" } } }
