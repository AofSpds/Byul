        { "$ref": "#/$defs/sameForbiddenAmbiguous" }
      ]
    },
    "sameForbiddenAbsent": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "forbidden_behavior": { "const": "ABSENT" } } } } },
        { "properties": { "components": { "properties": { "forbidden_behavior": { "const": "ABSENT" } } } } }
      ] } }
    },
    "sameForbiddenPresent": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "forbidden_behavior": { "const": "PRESENT" } } } } },
        { "properties": { "components": { "properties": { "forbidden_behavior": { "const": "PRESENT" } } } } }
      ] } }
    },
    "sameForbiddenAmbiguous": {
      "properties": { "graders": { "prefixItems": [
