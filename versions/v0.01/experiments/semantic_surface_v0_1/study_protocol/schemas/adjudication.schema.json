        { "properties": { "components": { "properties": { "outcome_tuple": { "const": "FAIL" } } } } }
      ] } }
    },
    "sameOutcomeTupleAmbiguous": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "outcome_tuple": { "const": "AMBIGUOUS" } } } } },
        { "properties": { "components": { "properties": { "outcome_tuple": { "const": "AMBIGUOUS" } } } } }
      ] } }
    },
    "sameRequiredConditionsJudgment": {
      "oneOf": [
        { "$ref": "#/$defs/sameRequiredConditionsPass" },
        { "$ref": "#/$defs/sameRequiredConditionsFail" },
        { "$ref": "#/$defs/sameRequiredConditionsAmbiguous" }
      ]
    },
    "sameRequiredConditionsPass": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "required_conditions": { "const": "PASS" } } } } },
        { "properties": { "components": { "properties": { "required_conditions": { "const": "PASS" } } } } }
      ] } }
    },
    "sameRequiredConditionsFail": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "required_conditions": { "const": "FAIL" } } } } },
        { "properties": { "components": { "properties": { "required_conditions": { "const": "FAIL" } } } } }
      ] } }
    },
    "sameRequiredConditionsAmbiguous": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "required_conditions": { "const": "AMBIGUOUS" } } } } },
        { "properties": { "components": { "properties": { "required_conditions": { "const": "AMBIGUOUS" } } } } }
      ] } }
    },
    "sameForbiddenBehaviorJudgment": {
      "oneOf": [
        { "$ref": "#/$defs/sameForbiddenAbsent" },
