        { "properties": { "components": { "properties": { "forbidden_behavior": { "const": "AMBIGUOUS" } } } } }
      ] } }
    },
    "sameEvidenceSufficiencyJudgment": {
      "oneOf": [
        { "$ref": "#/$defs/sameEvidenceSufficient" },
        { "$ref": "#/$defs/sameEvidenceInsufficient" },
        { "$ref": "#/$defs/sameEvidenceAmbiguous" }
      ]
    },
    "sameEvidenceSufficient": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "evidence_sufficiency": { "const": "SUFFICIENT" } } } } },
        { "properties": { "components": { "properties": { "evidence_sufficiency": { "const": "SUFFICIENT" } } } } }
      ] } }
    },
    "sameEvidenceInsufficient": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "evidence_sufficiency": { "const": "INSUFFICIENT" } } } } },
        { "properties": { "components": { "properties": { "evidence_sufficiency": { "const": "INSUFFICIENT" } } } } }
      ] } }
    },
    "sameEvidenceAmbiguous": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "evidence_sufficiency": { "const": "AMBIGUOUS" } } } } },
        { "properties": { "components": { "properties": { "evidence_sufficiency": { "const": "AMBIGUOUS" } } } } }
      ] } }
    },
    "sameRetentionJudgment": {
      "oneOf": [
        { "$ref": "#/$defs/sameRetentionPass" },
        { "$ref": "#/$defs/sameRetentionFail" },
        { "$ref": "#/$defs/sameRetentionNotApplicable" },
        { "$ref": "#/$defs/sameRetentionAmbiguous" }
      ]
    },
    "sameRetentionPass": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "retention": { "const": "PASS" } } } } },
        { "properties": { "components": { "properties": { "retention": { "const": "PASS" } } } } }
      ] } }
    },
    "sameRetentionFail": {
      "properties": { "graders": { "prefixItems": [
        { "properties": { "components": { "properties": { "retention": { "const": "FAIL" } } } } },
