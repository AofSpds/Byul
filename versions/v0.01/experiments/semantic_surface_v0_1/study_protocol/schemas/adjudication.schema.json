    "relink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_role_id",
        "candidate_id",
        "candidate_ref",
        "adapter_ref",
        "mapping_digest_sha256",
        "pre_relink_grade_freeze_digest_sha256",
        "grade_freeze_frozen_at",
        "relinked_at",
        "ordering_check",
